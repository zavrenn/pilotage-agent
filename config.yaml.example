# Pilotage Agent behavior. Copied to ~/.pilotage-agent/config.yaml by
# scripts/install.sh. Sensitive values belong in ~/.pilotage-agent/.env.

# Static runtime messages only. Put the agent's response language and register
# in SOUL.md. Supported values: en, fr, ar.
display:
  language: fr

# IANA timezone. Blank means the machine's local timezone.
timezone: ""

agent:
  model: gpt-5.6-sol
  reasoning_effort: medium
  # Identity is read from the profile-local SOUL.md file.
  # instructions: Optional runtime overlay applied after SOUL.md.
  history_turns: 20
  request_timeout: 300
  first_event_timeout: 120
  quiet_stream_timeout: 12
  # Send one short heartbeat at this interval during long turns. 0 disables it.
  working_notice_interval: 180
  working_notice_text: Je continue.

compression:
  codex_responses_native: true
  codex_responses_compact_threshold: 200000

# Same reset modes and defaults as current Hermes. "none" means never.
session_reset:
  mode: none
  idle_minutes: 1440
  at_hour: 4
  notify: true

sessions:
  # Ended sessions and their isolated workspaces remain until cleanup is enabled.
  auto_prune: false
  retention_days: 90
  # Optional restricted mode: one workspace per conversation session, with
  # native file delivery limited to that session's exports directory.
  isolated_workspaces: false

gateway:
  # Extra absolute directories from which MEDIA: files may be delivered.
  # The profile workspace is always included.
  media_delivery_allow_dirs: []

whatsapp:
  enabled: true
  group_policy: disabled
  group_allow_from: []
  require_mention: true
  batch_delay: 5
  batch_split_delay: 10
  batch_hard_cap: 20
  bridge_port: 8765
  read_receipts: false

telegram:
  enabled: false
  group_policy: disabled
  # Quoted numeric group/supergroup IDs, or ["*"] for every group.
  group_allow_from: []
  require_mention: true
  reply_to_mode: first
  batch_delay: 0.3
  batch_split_delay: 1
  media_batch_delay: 0.8
  batch_hard_cap: 20
  disable_link_previews: false

tools:
  enabled:
    - todo
    - terminal
    - code_execution
    - web
    - image_gen
    - vision
    - file
    - skills
    # Profile-wide; disable where unrelated users share one profile.
    - session_search
    - memory
    - cron
  max_iterations: 90
  max_result_chars: 100000
  max_step_chars: 200000

# Persistent changes pause the active conversation until the user replies
# /approve or /deny. Trusted profiles may disable categories independently.
approvals:
  memory: true
  skills: true
  cron: true
  timeout: 300

memory:
  memory_char_limit: 2200
  user_char_limit: 1375

image_gen:
  provider: openai-codex
  model: gpt-image-2-high

web:
  # Full-page extraction uses Firecrawl. Set FIRECRAWL_API_KEY in the profile
  # .env, or FIRECRAWL_API_URL for a self-hosted Firecrawl instance.
  # This is a per-page target; returned previews shrink when the combined
  # result must fit tools.max_result_chars. Full text remains cached.
  extract_char_limit: 15000

stt:
  enabled: true
  provider: openai
  echo_transcripts: true
  openai:
    model: whisper-1
  # language: fr
  # prompt: Optional names or vocabulary that improve recognition.

cron:
  enabled: true
  # Optional override; otherwise this inherits the profile timezone above.
  # timezone: Africa/Casablanca
  tick_seconds: 1
  claim_ttl_seconds: 1800
  max_concurrent: 2
  output_retention: 50

terminal:
  # Defaults to this profile's isolated workspace directory.
  # Its AGENTS.md instructions are loaded when each conversation starts.
  # Relative file-tool paths follow the terminal session's current directory.
  # cwd: /srv/agents/my-agent
  timeout: 120

code_execution:
  # Shared across profiles. Relative paths resolve from the installation root.
  root: .pilotage-envs
  timeout: 300

skills:
  # Skills are installed per profile under ~/.pilotage-agent/skills.
  template_vars: true
  # Trusted skills may opt into Hermes' inline !`command` expansion.
  inline_shell: false
  inline_shell_timeout: 10
  # disabled: [skill-name]
