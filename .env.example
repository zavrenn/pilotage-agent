# Pilotage Agent settings. Copied to ~/.pilotage-agent/.env by scripts/install.sh.
# Real environment variables win over anything set here.

# Who the agent answers. Phone numbers in digits, comma separated, country code
# included and no plus sign. Leave this empty and the agent answers nobody.
PILOTAGE_ALLOWED_SENDERS=

# Answer messages sent in groups. Off by default.
PILOTAGE_ANSWER_GROUPS=0

# Model and reasoning effort.
PILOTAGE_MODEL=gpt-5.6-sol
PILOTAGE_REASONING_EFFORT=medium

# What the agent is. One paragraph, no line breaks.
# PILOTAGE_INSTRUCTIONS=

# Seconds of quiet before a burst of messages is treated as one question.
PILOTAGE_TEXT_BATCH_DELAY=5
PILOTAGE_TEXT_BATCH_SPLIT_DELAY=10

# Local port for the WhatsApp bridge. Only ever bound to 127.0.0.1.
PILOTAGE_BRIDGE_PORT=8765

# Mark incoming messages as read (the blue ticks). Off by default, so an agent
# watching a chat does not silently mark everything as read.
PILOTAGE_SEND_READ_RECEIPTS=0
