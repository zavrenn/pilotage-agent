# Sensitive, deployment-specific identities. Copied to
# ~/.pilotage-agent/.env by scripts/install.sh and restricted to its owner.

# Phone numbers in digits, comma separated, country code included and no plus
# sign. Empty means the agent answers nobody.
PILOTAGE_ALLOWED_SENDERS=

# Optional OpenAI API key for automatic voice-message transcription. ChatGPT
# subscription authentication does not authorize the audio transcription API.
VOICE_TOOLS_OPENAI_KEY=
